# ==============================================================================
# Kanasta - Variables de Entorno de Ejemplo (.env.example)
# Copiar este archivo como .env para configuración local.
# ADVERTENCIA: NUNCA almacenes contraseñas reales ni secretos en el repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración del Negocio y Jurisdicción (Anexo A)
# ------------------------------------------------------------------------------
KANASTA_COUNTRY=VE
KANASTA_DEFAULT_CURRENCY=USD
KANASTA_TIMEZONE=America/Caracas
KANASTA_PRICES_INCLUDE_TAX=false

# ------------------------------------------------------------------------------
# Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kanasta_db
POSTGRES_USER=kanasta_user
POSTGRES_PASSWORD=kanasta_secret_password_change_in_production
CONNECTION_STRINGS__DEFAULTCONNECTION=Host=localhost;Port=5432;Database=kanasta_db;Username=kanasta_user;Password=kanasta_secret_password_change_in_production;

# ------------------------------------------------------------------------------
# Seguridad y Autenticación (ASP.NET Core Web API)
# ------------------------------------------------------------------------------
# Clave simétrica de al menos 32 caracteres para JWT en desarrollo
JWT__SECRET=kanasta_dev_jwt_secret_key_minimum_32_characters_long_super_secure!
JWT__ISSUER=KanastaApi
JWT__AUDIENCE=KanastaDesktop
JWT__EXPIRATIONMINUTES=480

# ------------------------------------------------------------------------------
# API de Negocio (ASP.NET Core)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# ------------------------------------------------------------------------------
# Aplicación de Escritorio (Desktop / Tauri / React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="Kanasta POS"
